# Optional. Without these, EcoBite still runs:
# printed receipt photos are read on this machine, typed lists estimate shelf life,
# and the browser's own voice speaks the chef.
# GEMINI_API_KEY lets a photo of unlabeled food be recognized, not just the printed words.
# ELEVENLABS_API_KEY lets the chef speak with ElevenLabs instead of the browser.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Rachel, a clear premade ElevenLabs voice. Swap the id if you want another.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# SpacetimeDB — live shared room (offer, claim, host, shelf).
# Leave both blank to keep the in-server booth room.
# URI is the cluster. Database is the name you publish the module as.
# Restart `npm run dev` after setting these; they are inlined into the browser.
# NEXT_PUBLIC_SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIMEDB_DATABASE=ecobite-bursley

# Neon — profiles, shelf, rescue history, recipe history.
# Pooled connection string from the Neon dashboard (postgresql://...).
# Leave blank to keep the shelf in local Postgres (PGlite).
# NEON_DATABASE_URL=

# Tiger Data — waste_events hypertable and the impact_daily continuous aggregate.
# Service connection string from Tiger Cloud (postgresql://...?sslmode=require).
# Leave blank and the Impact page reads the same rollup from local Postgres.
# TIGER_DATABASE_URL=
